# APP Name
APP_NAME=

# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Database driver: neon-http | node-postgres
# Optional; defaults to neon-http for *.neon.tech URLs, node-postgres otherwise
DATABASE_DRIVER=

# Better Auth configuration

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `pnpm dlx @better-auth/cli secret`
CERTIFICATE_MASTER_KEY= # 32 random bytes encoded as base64url, e.g. `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
# Required when a certificate uses the ZeroSSL ACME provider
ACME_EAB_KID=
ACME_EAB_HMAC_KEY=
CLOUDFLARE_DNS_API_TOKEN= # Optional; requires DNS Edit for CLOUDFLARE_DNS_ZONE_ID
CLOUDFLARE_DNS_ZONE_ID= # Optional; both Cloudflare values enable automatic ACME DNS-01 validation

# Bootstrap DNS for server sing-box configs, used before any tunnel exists and
# for peer hostnames. Type: tls | udp | local (host resolver, ignores the server).
# The server must be an IP literal. Defaults: tls 8.8.8.8. Use a reachable
# resolver such as 223.5.5.5 where TCP/853 to 8.8.8.8 is blocked.
SING_BOX_BOOTSTRAP_DNS_TYPE=
SING_BOX_BOOTSTRAP_DNS_SERVER=

# Optional Redis pub/sub backplane for agent WebSocket fan-out across multiple
# Node or Vercel instances. Cloudflare uses the AgentSessionDO binding.
REDIS_URL=

# Scheduler-only bearer token for bounded maintenance routes such as
# /api/maintenance/server-metrics. Leave unset to disable them.
MAINTENANCE_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
