        "value": "(\"kind\" = 'peer_link' AND \"link_id\" IS NOT NULL)\n        OR (\"kind\" = 'direct_profile' AND \"link_id\" IS NULL)\n        OR (\"kind\" = 'custom_proxy' AND \"link_id\" IS NULL AND \"protocol\" IS NOT NULL)\n        OR (\"kind\" = 'outbound_group' AND \"link_id\" IS NULL AND \"protocol\" IN ('selector', 'urltest'))"
      }
    }
  ]
}
