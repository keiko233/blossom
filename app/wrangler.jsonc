{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blossom",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_SESSION_DO",
        "class_name": "AgentSessionDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentSessionDO"],
    },
  ],
  // Optional Cloudflare Email Service binding. Uncomment and onboard a sender
  // domain to send through Cloudflare Workers Mail, then set
  // EMAIL_PROVIDER=cloudflare (or leave it unset to auto-detect).
  // "send_email": [{ "name": "SEND_EMAIL" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d00a6bf46b24b74a1c833dc992e3ef5",
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "f671efd043854dc9887eba3941ec0cbe",
    },
  ],
  "main": "./src/server.ts",
  // Preserve dashboard-managed plaintext vars across `wrangler deploy`
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
}
