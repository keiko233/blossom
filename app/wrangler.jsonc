{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blossom",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d00a6bf46b24b74a1c833dc992e3ef5",
    },
  ],
  "main": "./src/server.ts",
  // Preserve dashboard-managed plaintext vars across `wrangler deploy`
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
}
