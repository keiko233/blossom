{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blossom",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  // Preserve dashboard-managed plaintext vars across `wrangler deploy`
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
}
