{
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "info": {
    "title": "Blossom API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UndefinedError": {
        "type": "object",
        "properties": {
          "defined": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "status",
          "message"
        ]
      },
      "CertificateArtifact": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fingerprintSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "notBefore": {
            "type": "string"
          },
          "notAfter": {
            "type": "string"
          },
          "certificatePem": {
            "type": "string",
            "minLength": 1
          },
          "privateKeyPem": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "certificateId",
          "generation",
          "domains",
          "fingerprintSha256",
          "notBefore",
          "notAfter",
          "certificatePem",
          "privateKeyPem"
        ]
      },
      "ManagedTlsBinding": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "inboundTag": {
            "type": "string",
            "minLength": 1
          },
          "certificateId": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "serverName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "nodeId",
          "inboundTag",
          "certificateId",
          "generation",
          "serverName"
        ]
      },
      "ManagedPeerTlsBinding": {
        "type": "object",
        "properties": {
          "bindingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "runtimeTag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound"
            ],
            "type": "string"
          },
          "ownerKind": {
            "enum": [
              "peer_inbound",
              "peer_outbound"
            ],
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "certificateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fingerprintSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "serverName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "usage": {
            "enum": [
              "identity_fullchain_and_key",
              "peer_ca_trust"
            ],
            "type": "string"
          }
        },
        "required": [
          "bindingId",
          "runtimeTag",
          "direction",
          "ownerKind",
          "ownerId",
          "certificateId",
          "generation",
          "fingerprintSha256",
          "serverName",
          "usage"
        ]
      },
      "ManagedPeerTrustArtifact": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fingerprintSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "notBefore": {
            "type": "string"
          },
          "notAfter": {
            "type": "string"
          },
          "certificatePem": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "certificateId",
          "generation",
          "domains",
          "fingerprintSha256",
          "notBefore",
          "notAfter",
          "certificatePem"
        ]
      },
      "ManagedRuleSetBinding": {
        "type": "object",
        "properties": {
          "runtimeTag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ruleSetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "format": {
            "enum": [
              "binary"
            ],
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 524288
          }
        },
        "required": [
          "runtimeTag",
          "ruleSetId",
          "version",
          "format",
          "sha256",
          "sizeBytes"
        ]
      },
      "ManagedRuleSetArtifact": {
        "type": "object",
        "properties": {
          "ruleSetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "format": {
            "enum": [
              "binary"
            ],
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 524288
          },
          "contentBase64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 699052
          }
        },
        "required": [
          "ruleSetId",
          "version",
          "format",
          "sha256",
          "sizeBytes",
          "contentBase64"
        ]
      },
      "ManagedProbeBinding": {
        "type": "object",
        "properties": {
          "linkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "credentialGeneration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sourceServerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "destinationServerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceOutboundTag": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "destinationInboundTag": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "linkId",
          "credentialGeneration",
          "sourceServerId",
          "destinationServerId"
        ],
        "additionalProperties": false
      },
      "ManagedSnapshotExtension": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "enum": [
              1
            ]
          },
          "configVersionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "intentDigest": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          },
          "managedFingerprint": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          },
          "tlsBindings": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/ManagedPeerTlsBinding"
            }
          },
          "peerTrustArtifacts": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/ManagedPeerTrustArtifact"
            }
          },
          "ruleSetBindings": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/ManagedRuleSetBinding"
            }
          },
          "ruleSetArtifacts": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/ManagedRuleSetArtifact"
            }
          },
          "probeBindings": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/ManagedProbeBinding"
            },
            "default": []
          }
        },
        "required": [
          "schemaVersion",
          "configVersionId",
          "intentDigest",
          "managedFingerprint",
          "tlsBindings",
          "peerTrustArtifacts",
          "ruleSetBindings",
          "ruleSetArtifacts"
        ]
      }
    }
  },
  "openapi": "3.0.3",
  "paths": {
    "/agent/config/v3": {
      "get": {
        "operationId": "getAgentConfigV3",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "enum": [
                        3
                      ]
                    },
                    "agent": {
                      "type": "object",
                      "properties": {
                        "configPollIntervalSeconds": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "heartbeatIntervalSeconds": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "desiredAgentVersion": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "desiredSingBoxVersion": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "required": [
                        "configPollIntervalSeconds",
                        "heartbeatIntervalSeconds"
                      ]
                    },
                    "desiredRevision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "materializedNodeIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "singboxConfig": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "managedTlsBindings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ManagedTlsBinding"
                      }
                    },
                    "certificateArtifacts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CertificateArtifact"
                      }
                    },
                    "managed": {
                      "$ref": "#/components/schemas/ManagedSnapshotExtension"
                    }
                  },
                  "required": [
                    "apiVersion",
                    "agent",
                    "desiredRevision",
                    "materializedNodeIds",
                    "singboxConfig",
                    "managedTlsBindings",
                    "certificateArtifacts"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/heartbeat": {
      "post": {
        "operationId": "agentHeartbeat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agentBuildId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "agentCapabilities": {
                    "type": "array",
                    "maxItems": 1024,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "agentVersion": {
                    "type": "string"
                  },
                  "singBoxVersion": {
                    "type": "string"
                  },
                  "runtimeState": {
                    "enum": [
                      "unknown",
                      "starting",
                      "running",
                      "stopped",
                      "crash_loop"
                    ],
                    "type": "string"
                  },
                  "configState": {
                    "enum": [
                      "unknown",
                      "applied",
                      "rejected",
                      "apply_failed"
                    ],
                    "type": "string"
                  },
                  "observedRevision": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "appliedRevision": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "activeNodeIds": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "clearActiveNodeIds": {
                    "type": "boolean"
                  },
                  "effectiveConfigPollIntervalSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "effectiveHeartbeatIntervalSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "appliedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "clearError": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "phase": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "nodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "phase",
                      "code",
                      "message"
                    ]
                  },
                  "certificateDeployments": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "certificateId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "fingerprintSha256": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "installed": {
                          "type": "boolean"
                        },
                        "inUse": {
                          "type": "boolean"
                        },
                        "errorPhase": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "errorMessage": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "certificateId",
                        "generation",
                        "fingerprintSha256",
                        "installed",
                        "inUse"
                      ]
                    }
                  },
                  "updates": {
                    "type": "object",
                    "properties": {
                      "agent": {
                        "type": "object",
                        "properties": {
                          "targetVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "state": {
                            "enum": [
                              "unknown",
                              "idle",
                              "up_to_date",
                              "checking",
                              "downloading",
                              "verifying",
                              "applying",
                              "restarting",
                              "failed",
                              "disabled"
                            ],
                            "type": "string"
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "checkedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      "singBox": {
                        "type": "object",
                        "properties": {
                          "targetVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "state": {
                            "enum": [
                              "unknown",
                              "idle",
                              "up_to_date",
                              "checking",
                              "downloading",
                              "verifying",
                              "applying",
                              "restarting",
                              "failed",
                              "disabled"
                            ],
                            "type": "string"
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "checkedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "agentBuildId",
                  "agentCapabilities",
                  "certificateDeployments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/traffic": {
      "post": {
        "operationId": "reportAgentTraffic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reportId": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "windowStartedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "windowEndedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "entries": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "subscriptionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uplinkBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "downlinkBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "subscriptionId",
                        "uplinkBytes",
                        "downlinkBytes"
                      ]
                    }
                  }
                },
                "required": [
                  "entries"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "dropped": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "reportId": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "accepted",
                    "dropped"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}