{
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "info": {
    "title": "Blossom API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UndefinedError": {
        "type": "object",
        "properties": {
          "defined": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "status",
          "message"
        ]
      }
    }
  },
  "openapi": "3.0.3",
  "paths": {
    "/agent/config/v3": {
      "get": {
        "operationId": "getAgentConfigV3",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "enum": [
                        3
                      ]
                    },
                    "agent": {
                      "type": "object",
                      "properties": {
                        "configPollIntervalSeconds": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "heartbeatIntervalSeconds": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "configPollIntervalSeconds",
                        "heartbeatIntervalSeconds"
                      ]
                    },
                    "desiredRevision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "materializedNodeIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "singboxConfig": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "managedTlsBindings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nodeId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "inboundTag": {
                            "type": "string",
                            "minLength": 1
                          },
                          "certificateId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "generation": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "serverName": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "nodeId",
                          "inboundTag",
                          "certificateId",
                          "generation",
                          "serverName"
                        ]
                      }
                    },
                    "certificateArtifacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "certificateId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "generation": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "domains": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "fingerprintSha256": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "notBefore": {
                            "type": "string"
                          },
                          "notAfter": {
                            "type": "string"
                          },
                          "certificatePem": {
                            "type": "string",
                            "minLength": 1
                          },
                          "privateKeyPem": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "certificateId",
                          "generation",
                          "domains",
                          "fingerprintSha256",
                          "notBefore",
                          "notAfter",
                          "certificatePem",
                          "privateKeyPem"
                        ]
                      }
                    }
                  },
                  "required": [
                    "apiVersion",
                    "agent",
                    "desiredRevision",
                    "materializedNodeIds",
                    "singboxConfig",
                    "managedTlsBindings",
                    "certificateArtifacts"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/heartbeat": {
      "post": {
        "operationId": "agentHeartbeat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agentBuildId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "agentCapabilities": {
                    "type": "array",
                    "maxItems": 1024,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "agentVersion": {
                    "type": "string"
                  },
                  "singBoxVersion": {
                    "type": "string"
                  },
                  "runtimeState": {
                    "enum": [
                      "unknown",
                      "starting",
                      "running",
                      "stopped",
                      "crash_loop"
                    ],
                    "type": "string"
                  },
                  "configState": {
                    "enum": [
                      "unknown",
                      "applied",
                      "rejected",
                      "apply_failed"
                    ],
                    "type": "string"
                  },
                  "observedRevision": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "appliedRevision": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "activeNodeIds": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "clearActiveNodeIds": {
                    "type": "boolean"
                  },
                  "effectiveConfigPollIntervalSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "effectiveHeartbeatIntervalSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "appliedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "clearError": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "phase": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "nodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "phase",
                      "code",
                      "message"
                    ]
                  },
                  "certificateDeployments": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "certificateId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "fingerprintSha256": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "installed": {
                          "type": "boolean"
                        },
                        "inUse": {
                          "type": "boolean"
                        },
                        "errorPhase": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "errorMessage": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "certificateId",
                        "generation",
                        "fingerprintSha256",
                        "installed",
                        "inUse"
                      ]
                    }
                  }
                },
                "required": [
                  "agentBuildId",
                  "agentCapabilities",
                  "certificateDeployments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/traffic": {
      "post": {
        "operationId": "reportAgentTraffic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "windowStartedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "windowEndedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "entries": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "subscriptionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uplinkBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "downlinkBytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "subscriptionId",
                        "uplinkBytes",
                        "downlinkBytes"
                      ]
                    }
                  }
                },
                "required": [
                  "entries"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "dropped": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "accepted",
                    "dropped"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}