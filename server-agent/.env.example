# ── blossom server-agent ──────────────────────────────────────────────────────
# Copy to .env and fill in, then: docker compose up -d
#   cp .env.example .env

# Base URL of the blossom control-plane API, including the /api prefix.
AGENT_URL=https://blossom.example.com/api

# Per-server agent token — the agt_... value shown once when the server is
# created (or its token is reset) in the admin UI. Keep it secret.
AGENT_TOKEN=agt_replace_me

# Bootstrap interval used until the first /agent/config/v3 response. Afterwards
# the control plane's per-server config/heartbeat intervals take over.
AGENT_INTERVAL=60

# Log verbosity: trace | debug | info | warn | error
AGENT_LOG_LEVEL=info

# ACME (agent-executed certificate issuance).
# The ephemeral HTTP-01 responder binds this address only while an http-01 job
# runs. Port 80 must be publicly reachable on the issuer server for that mode.
# AGENT_ACME_HTTP_BIND=0.0.0.0:80
# Delay after the control plane acknowledges a DNS TXT record (0-300 seconds).
# AGENT_ACME_DNS_SETTLE_SECONDS=5
# Interactive admin terminal over the authenticated agent WebSocket. Off by
# default; the control plane only offers the terminal when the agent advertises
# pty-v1. Sessions are capped and close after the idle timeout.
# AGENT_PTY_ENABLED=true
# AGENT_PTY_MAX_SESSIONS=2
# AGENT_PTY_IDLE_TIMEOUT_SECONDS=900
# AGENT_PTY_MAX_SESSION_SECONDS=3600

# First-start binary versions. "latest" resolves the published release; pin an
# exact version for reproducible bootstrap. After startup the control plane's
# per-server desired versions drive updates.
AGENT_BOOTSTRAP_VERSION=latest
AGENT_SING_BOX_BOOTSTRAP_VERSION=latest

# Optional GitHub token for release API/download rate limits. Keep it secret.
# AGENT_GITHUB_TOKEN=

# Address family for the entrypoint's GitHub requests: prefer | only | off.
# "prefer" (the default) tries IPv6 first and falls back to the default order;
# "only" fails when the host has no IPv6 route or the name has no AAAA record.
# AGENT_GITHUB_IPV6=prefer

# The container stores binaries, state and downloads below the mounted /data
# volume. These defaults are set by the image.
# AGENT_DATA_DIR=/data
# AGENT_STATE_DIR=/data/state
# AGENT_DOWNLOAD_DIR=/data/downloads
# AGENT_BIN_PATH=/data/bin/server-agent
# AGENT_SING_BOX_PATH=/data/bin/sing-box

# The entrypoint enables self-update. Set to 0 for a read-only/externally
# supervised install.
# AGENT_SELF_UPDATE=1

# Release sources (forks/private mirrors).
# AGENT_RELEASE_REPO=keiko233/blossom
# AGENT_SING_BOX_RELEASE_REPO=SagerNet/sing-box
# AGENT_GITHUB_API=https://api.github.com

# Test/offline seeding: copy `server-agent` and `sing-box` from this directory
# into /data/bin when they are absent. The test image uses this instead of
# downloading at container start.
# AGENT_SEED_DIR=/opt/blossom-seed
